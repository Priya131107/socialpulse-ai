# SocialPulse AI Environment Variables

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=socialpulse-secret-key-change-in-production

# Model & Device Configuration
USE_GPU=false
SENTIMENT_ENGINE=vader  # 'vader' or 'transformer'

# Database
DATABASE_URL=sqlite:///./socialpulse.db
ALERTS_DATABASE_URL=sqlite:///./alerts.db

# Alerting Credentials (Optional - mocks used if missing)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=

SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

